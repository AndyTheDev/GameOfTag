{
  "name": "game_of_tag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"NEXT,WORKER\" -c \"cyan,magenta\" \"next dev\" \"tsx src/worker.ts\"",
    "build": "next build",
    "start": "concurrently -n \"NEXT,WORKER\" -c \"cyan,magenta\" \"next start\" \"tsx src/worker.ts\"",
    "lint": "eslint",
    "db:dump": "npx tsx scripts/dump-data.ts",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:delete-seed": "npx tsx scripts/delete-seed.ts"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.44.7",
    "next": "^16.1.2",
    "postgres": "^3.4.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
